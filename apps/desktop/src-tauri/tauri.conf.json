{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deepread",
  "version": "0.1.0",
  "identifier": "app.deepread.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @deepread/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @deepread/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deepread",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' blob: asset: http://asset.localhost ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; frame-src 'self' blob:; media-src 'self' asset: http://asset.localhost blob:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzREY4QzJCQUYyMzAxNUQKUldSZEFTT3ZLNHpmbzcvQmhTZzFWanQvbE4wN1h0ZzZNT1lZSS9JMlNVVzlrQVlPcmhOVHRucUMK",
      "endpoints": [
        "https://deepread-updates.example.invalid/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
